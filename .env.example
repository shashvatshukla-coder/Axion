# Copy to .env locally. Never commit credentials.
DATABASE_URL=postgresql://foundry:local-development-only@localhost:5432/foundry
DATABASE_SSL=false
PORT=3001
APP_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Vite proxies /api in development; Express serves both frontend and API in production.
VITE_API_URL=/api
POSTGRES_PASSWORD=local-development-only
